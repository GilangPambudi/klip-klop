# Sign-in. Leave AUTH_SECRET unset to run without accounts (local launcher).
# Generate one with: openssl rand -base64 33
AUTH_SECRET=
# Public URL of the app, e.g. https://klip.example.com (http://localhost:4200 in dev)
AUTH_URL=

# Discord: redirect URL is <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Google: ready but off. Redirect URL is <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MySQL / MariaDB. Accounts, credits and the download history live here.
# Create the tables with: npm run db:migrate
# Every account starts with 3 credits. To make one unlimited or to ban it, set
# `unlimited` or `banned` to 1 on its row in the `users` table.
# Default resolution, default theme and how long downloads are kept are rows
# in the `config` table (see README).
DATABASE_URL=mysql://user:password@localhost:3306/klip_klop
