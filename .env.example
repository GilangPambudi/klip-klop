DOWNLOAD_RETENTION_HOURS=24

# Sign-in. Leave AUTH_SECRET unset to run without accounts (local launcher).
# Generate one with: openssl rand -base64 33
AUTH_SECRET=
# Public URL of the app, e.g. https://klip.example.com (http://localhost:4200 in dev)
AUTH_URL=

# Discord: redirect URL is <AUTH_URL>/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Google: ready but off. Redirect URL is <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Every account starts with 3 download credits that never refill.
# Accounts listed here are never charged. Comma-separated account IDs as shown
# in the Profile dialog, e.g. discord:123456789012345678
AUTH_UNLIMITED_IDS=
