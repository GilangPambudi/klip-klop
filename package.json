{
  "name": "ngeklip",
  "version": "2.0.0",
  "description": "Clip the YouTube's video",
  "author": "Gilang Pambudi",
  "license": "MIT",
  "scripts": {
    "trim": "node src/actions/single-part.js",
    "trimall": "node src/actions/multiple-parts.js",
    "start": "node src/server/server.js",
    "watch:css": "npx tailwindcss -i ./public/input.css -o ./public/style.css --watch",
    "dev": "concurrently \"npm:start\" \"npm:run watch:css\"",
    "build": "npx tailwindcss -i ./public/input.css -o ./public/style.css"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "readline-sync": "^1.4.10",
    "tailwindcss": "^3.4.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
